---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.jsx';
import IslandStyles from '../components/IslandStyles.astro';
import { site, whatsappHref, gmailHref, directionsHref, mapEmbedSrc } from '../data/site.js';
import { breadcrumbSchema } from '../data/schema.js';
---

<BaseLayout
  title="Contact Chinmayi Events | Event Decoration in Chikkamagaluru"
  description="Contact Chinmayi Events for wedding decoration, reception stage, birthday decor, engagement decor and shamiyana setup in Chikkamagaluru."
  canonical="/contact/"
  jsonLd={breadcrumbSchema([['Contact', '/contact/']])}
>
  <IslandStyles />
  <section class="interior-hero" style="--page-hero-image: url('/images/opt/chikkamagaluru-custom-event-design-1200.webp')">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1>Book event decoration in Chikkamagaluru.</h1>
      <p class="lead">
        Share your event date, venue, guest size and decoration idea. Chinmayi
        Events will help with availability and quote details.
      </p>
      <div class="hero-kicker-row">
        <span>Call</span>
        <span>WhatsApp</span>
        <span>Quote request</span>
      </div>
    </div>
  </section>

  <section class="section contact-overview">
    <div class="container split">
      <div>
        <p class="eyebrow">Quick contact</p>
        <h2 class="section-title">Tell us what you are planning.</h2>
        <p class="lead">
          For faster pricing, include your event date, venue or area, guest count,
          function type and any reference photos you like.
        </p>
      </div>
      <div class="contact-card luxe-panel">
        <span class="contact-person">Contact person: {site.contactPerson}</span>
        <a href={`tel:${site.phonePrimary}`}>{site.phonePrimaryLabel}</a>
        <span>{site.phoneSecondaryLabel}</span>
        <a href={gmailHref()} target="_blank" rel="noopener noreferrer">{site.email}</a>
        <address>{site.address}</address>
        <span>{site.openingHoursLabel}</span>
        <div class="btn-row">
          <a class="button button-dark" href={whatsappHref()} target="_blank" rel="noopener noreferrer">WhatsApp</a>
          <a class="button button-outline" href={directionsHref()} target="_blank" rel="noopener noreferrer">Directions</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section map-section">
    <div class="container">
      <p class="eyebrow">Find us</p>
      <h2 class="section-title">Chinmayi Events on Google Maps</h2>
      <p class="lead map-lead">{site.address}</p>
      <div class="map-frame">
        <iframe
          src={mapEmbedSrc()}
          title={`Google Maps location of ${site.name} in ${site.locality}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
      <div class="btn-row map-actions">
        <a class="button button-dark" href={site.googleMapsUrl} target="_blank" rel="noopener noreferrer">
          Open in Google Maps
        </a>
        <a class="button button-outline" href={directionsHref()} target="_blank" rel="noopener noreferrer">
          Get Directions
        </a>
      </div>
    </div>
  </section>

  <section class="section band form-band">
    <div class="container split">
      <div>
        <p class="eyebrow">Enquiry form</p>
        <h2 class="section-title">Request a quote</h2>
        <p class="lead">The more details you share, the faster we can guide you.</p>
        <div class="contact-points">
          <span>Event date</span>
          <span>Venue area</span>
          <span>Preferred theme</span>
        </div>
      </div>
      <ContactForm client:load />
    </div>
  </section>
</BaseLayout>

<style>
  .map-section {
    background: #fffaf1;
  }

  .map-lead {
    max-width: 60ch;
  }

  .map-frame {
    margin-top: 22px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 6px;
    box-shadow: 0 12px 30px rgba(38, 23, 15, 0.08);
  }

  .map-frame iframe {
    display: block;
    width: 100%;
    height: 420px;
    border: 0;
  }

  .map-actions {
    margin-top: 20px;
  }

  @media (max-width: 620px) {
    .map-frame iframe {
      height: 300px;
    }
  }

  .contact-card address {
    margin: 0;
    color: var(--muted);
    font-style: normal;
  }

  .contact-card {
    display: grid;
    gap: 12px;
    padding: 26px;
  }

  .contact-card a,
  .contact-card span {
    font-weight: 850;
    color: var(--maroon-dark);
  }

  .contact-card p {
    color: var(--muted);
  }

  .contact-person {
    color: var(--gold-dark) !important;
    font-size: 0.78rem;
    font-weight: 950;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .form-band {
    background:
      linear-gradient(180deg, rgba(251, 247, 239, 0.96), rgba(255, 253, 248, 0.98)),
      url('/images/opt/chikkamagaluru-gallery-wedding-mandap-2-1200.webp') center/cover;
  }

  .contact-points {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }

  .contact-points span {
    border: 1px solid rgba(111, 24, 50, 0.16);
    border-radius: 999px;
    background: #fff;
    color: var(--maroon);
    padding: 9px 13px;
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
  }
</style>

