---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ContactForm from '../components/ContactForm.jsx';
import TestimonialsPanel from '../components/TestimonialsPanel.jsx';
import IslandStyles from '../components/IslandStyles.astro';
import SmartImage from '../components/SmartImage.astro';
import { areasServed, faqs, services, site, whatsappHref } from '../data/site.js';
import { getExperiences, getGalleryItems, ratingSummary } from '../data/live-content.js';
import { reviewSchema } from '../data/schema.js';

// Reviews and highlights are pulled at build time so they are in the HTML the
// crawler reads. The LocalBusiness entity itself now lives in BaseLayout.
const experiences = await getExperiences();
const rating = ratingSummary(experiences);
const highlightItems = (await getGalleryItems())
  .filter((item) => item.isHighlight && item.cloudinaryUrl)
  .slice(0, 8);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer
    }
  }))
};

const signatureServices = [
  {
    label: 'Wedding Decoration',
    href: '/services/wedding-decoration-chikkamagaluru/',
    image: '/images/chikkamagaluru-wedding-stage-decoration.jpg',
    alt: 'Wedding stage decoration with floral backdrop by Chinmayi Events in Chikkamagaluru'
  },
  {
    label: 'House Warming',
    href: '/services/housewarming-decoration-chikkamagaluru/',
    image: '/images/chikkamagaluru-event-centerpiece-decoration.avif',
    alt: 'Floral centerpiece decoration for a housewarming celebration in Chikkamagaluru'
  },
  {
    label: 'Reception Decor',
    href: '/services/reception-stage-decoration-chikkamagaluru/',
    image: '/images/chikkamagaluru-reception-stage-decoration.jpeg',
    alt: 'Reception stage decoration with lighting by Chinmayi Events in Chikkamagaluru'
  },
  {
    label: 'Outdoor Events',
    href: '/services/outdoor-event-decoration-chikkamagaluru/',
    image: '/images/chikkamagaluru-gallery-outdoor-decor-5.jpeg',
    alt: 'Outdoor event decoration set up on open ground in Chikkamagaluru'
  },
  {
    label: 'Birthday Parties',
    href: '/services/birthday-decoration-chikkamagaluru/',
    image: '/images/chikkamagaluru-birthday-cake-table-decoration.jpg',
    alt: 'Birthday cake table decoration with balloons by Chinmayi Events'
  },
  {
    label: 'Naming Ceremony',
    href: '/services/naming-ceremony-decoration-chikkamagaluru/',
    image: '/images/chikkamagaluru-gallery-entry-decoration-7.jpeg',
    alt: 'Floral entry decoration for a naming ceremony in Chikkamagaluru'
  },
  {
    label: 'Vehicle Decoration',
    href: '/services/vehicle-decoration-chikkamagaluru/',
    image: '/images/chikkamagaluru-flower-theme-decoration.jpg',
    alt: 'Fresh flower decoration work used for wedding vehicle decor'
  },
  {
    label: 'Floral Decoration',
    href: '/services/flower-theme-decoration-chikkamagaluru/',
    image: '/images/chikkamagaluru-gallery-floral-backdrop-9.jpeg',
    alt: 'Floral backdrop wall decoration by Chinmayi Events in Chikkamagaluru'
  }
];

const galleryItems = [
  ['/images/chikkamagaluru-gallery-night-stage-10.jpeg', 'Night wedding stage decoration with warm lighting in Chikkamagaluru'],
  ['/images/chikkamagaluru-reception-stage-decoration.jpeg', 'Reception stage decoration with floral backdrop in Chikkamagaluru'],
  ['/images/chikkamagaluru-gallery-wedding-mandap-2.jpeg', 'Traditional wedding mandap decoration by Chinmayi Events'],
  ['/images/chikkamagaluru-gallery-outdoor-decor-5.jpeg', 'Outdoor event decoration on open ground in Chikkamagaluru'],
  ['/images/chikkamagaluru-gallery-stage-lighting-8.jpeg', 'Event stage lighting setup for an evening function'],
  ['/images/chikkamagaluru-gallery-wedding-pathway-11.jpeg', 'Decorated wedding entrance pathway with floral arches'],
  ['/images/chikkamagaluru-gallery-floral-backdrop-9.jpeg', 'Floral backdrop wall for a wedding stage in Chikkamagaluru'],
  ['/images/chikkamagaluru-wedding-stage-decoration.jpg', 'Premium wedding stage decoration by Chinmayi Events'],
  ['/images/chikkamagaluru-gallery-entry-decoration-7.jpeg', 'Event entry decoration with flowers and lighting'],
  ['/images/chikkamagaluru-gallery-reception-stage-6.jpeg', 'Reception stage with couple seating and floral decor'],
  ['/images/chikkamagaluru-gallery-ceremony-stage-12.jpeg', 'Ceremony stage decoration for a family function in Chikkamagaluru'],
  ['/images/chikkamagaluru-gallery-floral-entrance-13.jpeg', 'Floral entrance arch decoration at an event venue'],
  ['/images/chikkamagaluru-gallery-stage-backdrop-14.jpeg', 'Custom stage backdrop decoration by Chinmayi Events'],
  ['/images/chikkamagaluru-gallery-wedding-decor-15.jpeg', 'Complete wedding venue decoration in Chikkamagaluru'],
  ['/images/chikkamagaluru-gallery-reception-decor-16.jpeg', 'Reception hall decoration with lighting and flower work'],
  ['/images/chikkamagaluru-gallery-floral-stage-17.jpeg', 'Floral stage decoration for a haldi ceremony'],
  ['/images/chikkamagaluru-gallery-event-lighting-18.jpeg', 'Event lighting and decoration setup in Chikkamagaluru']
];

const reasons = [
  {
    title: 'Creative Concepts',
    text: 'Unique ideas for every event',
    icon: 'M12 3l1.55 5.08L18 6l-2.08 4.45L21 12l-5.08 1.55L18 18l-4.45-2.08L12 21l-1.55-5.08L6 18l2.08-4.45L3 12l5.08-1.55L6 6l4.45 2.08L12 3Z'
  },
  {
    title: 'Premium Quality',
    text: 'Top quality flowers and materials',
    icon: 'M6.5 4h11L21 9l-9 11L3 9l3.5-5Zm-2 5h15M8 4l4 16 4-16'
  },
  {
    title: 'Experienced Team',
    text: 'Skilled and passionate decorators',
    icon: 'M16 19v-1.5a4 4 0 0 0-8 0V19m8-11a4 4 0 1 1-8 0 4 4 0 0 1 8 0Zm2.5 4.5a3 3 0 0 1 2.5 3V18M18 5.4a3 3 0 0 1 0 5.2'
  },
  {
    title: 'Timely Execution',
    text: 'On-time setup and perfection',
    icon: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0-13v5l3 2'
  },
  {
    title: 'Customer Satisfaction',
    text: 'Your happiness is our smile',
    icon: 'M20.4 5.6a5.1 5.1 0 0 0-7.2 0L12 6.8l-1.2-1.2a5.1 5.1 0 1 0-7.2 7.2L12 21l8.4-8.2a5.1 5.1 0 0 0 0-7.2Z'
  }
];

const steps = [
  ['01', 'Consultation', 'We listen to your ideas and requirements'],
  ['02', 'Planning', 'We plan and design your perfect event'],
  ['03', 'Execution', 'Our team brings the plan to life'],
  ['04', 'Perfection', 'We ensure every detail is perfect'],
  ['05', 'Memories', 'You enjoy the moment forever']
];

const instagramImages = galleryItems.slice(1, 7);
---

<BaseLayout
  title="Event Management & Decoration in Chikkamagaluru | Chinmayi Events"
  description="Chinmayi Events is an event management and decoration team in Chikkamagaluru for weddings, receptions, haldi, naming ceremonies, birthdays, housewarming and corporate events. Call for a quote."
  canonical="/"
  jsonLd={[faqSchema, ...reviewSchema(experiences)]}
  businessRating={rating}
  preloadHero={true}
>
  <IslandStyles />
  <Hero />

  <section id="services" class="section signature-services centered">
    <div class="container">
      <p class="eyebrow">What we do</p>
      <h2 class="section-title">Our Signature Services</h2>
      <div class="ornament"></div>
      <div class="service-strip">
        {signatureServices.map((service) => (
          <a href={service.href} class="service-tile">
            <SmartImage
              src={service.image}
              alt={service.alt}
              sizes="(max-width: 620px) 45vw, (max-width: 980px) 30vw, 320px"
              widths={[400, 800]}
              width="320"
              height="260"
            />
            <strong>{service.label}</strong>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section recent-work centered">
    <div class="container">
      <p class="eyebrow">Our work</p>
      <h2 class="section-title">Recent Decorations</h2>
      <div class="ornament"></div>
      <div class="masonry-gallery">
        {galleryItems.map(([src, alt], index) => (
          <figure class:list={[index === 0 || index === 3 ? 'tall' : '', index === 2 || index === 7 ? 'wide' : '']}>
            <SmartImage
              src={src}
              alt={alt}
              sizes="(max-width: 620px) 50vw, (max-width: 980px) 33vw, 25vw"
              widths={[400, 800, 1200]}
              loading={index < 2 ? 'eager' : 'lazy'}
            />
          </figure>
        ))}
      </div>
      <a class="button button-dark gallery-button" href="/gallery/">View All Gallery</a>
    </div>
  </section>

  <section class="section dark-band why-section centered">
    <div class="container">
      <p class="eyebrow">Why choose us</p>
      <h2 class="section-title">We Make Every Moment Special</h2>
      <div class="why-grid">
        {reasons.map((reason) => (
          <article>
            <span class="reason-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d={reason.icon} fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <h3>{reason.title}</h3>
            <p>{reason.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section process-section centered">
    <div class="container">
      <p class="eyebrow">Our process</p>
      <h2 class="section-title">From Concept to Celebration</h2>
      <div class="process-line">
        {steps.map(([number, title, text]) => (
          <article>
            <div class="process-icon">{number}</div>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="testimonials" class="section proof-section">
    <div class="container">
      <TestimonialsPanel
        client:load
        initialReviews={experiences}
        initialHighlights={highlightItems}
      />
    </div>
  </section>


  <section class="section instagram-section centered">
    <div class="container">
      <p class="eyebrow">Follow us on Instagram</p>
      <h2><a href={site.instagram} target="_blank" rel="noopener noreferrer">@chinmayi_events</a></h2>
      <div class="instagram-row">
        {instagramImages.map(([src, alt]) => (
          <a
            class="instagram-tile"
            href={site.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${alt} — view on Instagram`}
          >
            <SmartImage
              src={src}
              alt={alt}
              sizes="(max-width: 620px) 45vw, (max-width: 980px) 30vw, 180px"
              widths={[400, 800]}
              width="360"
              height="277"
            />
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section areas-section centered">
    <div class="container">
      <p class="eyebrow">Where we work</p>
      <h2 class="section-title">Event Decoration Across Chikkamagaluru District</h2>
      <div class="ornament"></div>
      <p class="lead areas-lead">
        Chinmayi Events is based in Chikkamagaluru and travels across the
        district for weddings, receptions and family functions. Share your venue
        and date and the team will confirm availability and travel for your area.
      </p>
      <ul class="areas-list">
        {areasServed.map((area) => (
          <li>{area}</li>
        ))}
      </ul>
      <div class="areas-services">
        {services.map((service) => (
          <a href={`/services/${service.slug}/`}>{service.shortTitle}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="whatsapp-band">
    <div class="container whatsapp-card">
      <div class="wa-icon">WA</div>
      <div>
        <h2>Let's Plan Your Dream Event</h2>
        <p>Get in touch with us for a free consultation.</p>
      </div>
      <a class="button button-primary" href={whatsappHref()} target="_blank" rel="noopener noreferrer">Chat on WhatsApp</a>
    </div>
  </section>

  <section id="quote" class="section contact-section">
    <div class="container split">
      <div>
        <p class="eyebrow">Request a quote</p>
        <h2 class="section-title">Tell us about your event date and venue.</h2>
        <p class="lead">
          Share the event type, venue, date, guest size and decoration style.
          Chinmayi Events will respond with next steps.
        </p>
      </div>
      <ContactForm client:load />
    </div>
  </section>
</BaseLayout>

<style>
  .signature-services {
    background: linear-gradient(180deg, #fffdf8, #fbf6ee);
  }

  .ornament {
    width: 64px;
    height: 12px;
    margin: 8px auto 34px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
    opacity: 0.8;
  }

  .service-strip {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 10px;
  }

  .service-tile {
    min-height: 174px;
    position: relative;
    display: grid;
    align-items: end;
    border: 1px solid var(--line);
    border-radius: 3px;
    overflow: hidden;
    background: var(--soft);
    box-shadow: 0 10px 28px rgba(38, 23, 15, 0.06);
  }

  .service-tile::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 24%, rgba(28, 15, 11, 0.82));
    transition: background 180ms ease;
  }

  .service-tile:hover::after {
    background: linear-gradient(180deg, rgba(28, 15, 11, 0.08), rgba(28, 15, 11, 0.88));
  }

  .service-tile :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 220ms ease;
  }

  .service-tile:hover :global(img) {
    transform: scale(1.045);
  }

  .service-tile strong {
    position: relative;
    z-index: 1;
    min-height: 48px;
    display: grid;
    place-items: center;
    padding: 10px;
    color: #fff8ec;
    font-size: 0.82rem;
    line-height: 1.2;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.36);
  }

  .masonry-gallery {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    grid-auto-rows: 132px;
    gap: 8px;
  }

  .masonry-gallery figure {
    margin: 0;
    overflow: hidden;
    border-radius: 4px;
    background: var(--soft);
  }

  .masonry-gallery figure.tall {
    grid-row: span 2;
  }

  .masonry-gallery figure.wide {
    grid-column: span 2;
  }

  .masonry-gallery :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 220ms ease;
  }

  .masonry-gallery figure:hover :global(img) {
    transform: scale(1.04);
  }

  .gallery-button {
    margin-top: 28px;
  }

  .why-section {
    background:
      linear-gradient(rgba(0, 0, 0, 0.86), rgba(0, 0, 0, 0.86)),
      url('/images/opt/chikkamagaluru-gallery-stage-lighting-8-800.webp') center/cover;
  }

  .why-section .section-title,
  .proof-section h2,
  .instagram-section h2,
  .whatsapp-card h2 {
    color: inherit;
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 22px;
    margin-top: 48px;
  }

  .reason-icon {
    width: 42px;
    height: 42px;
    margin: 0 auto;
    position: relative;
    display: grid;
    place-items: center;
    border: 1px solid rgba(217, 173, 82, 0.62);
    border-radius: 50%;
    background: rgba(217, 173, 82, 0.1);
    color: var(--gold);
  }

  .reason-icon::before {
    content: none;
    display: none;
  }

  .reason-icon svg {
    width: 22px;
    height: 22px;
    display: block;
    overflow: visible;
  }

  .reason-icon path {
    vector-effect: non-scaling-stroke;
  }

  .why-grid h3 {
    margin: 12px 0 8px;
    font-size: 1rem;
  }

  .why-grid p {
    margin: 0;
    color: rgba(255, 248, 236, 0.64);
    font-size: 0.82rem;
  }

  .process-line {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 28px;
    margin-top: 48px;
  }

  .process-line article {
    position: relative;
  }

  .process-line article:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 38px;
    right: -24px;
    width: 32px;
    border-top: 1px dashed var(--gold);
  }

  .process-icon {
    width: 78px;
    height: 78px;
    margin: 0 auto 16px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(217, 173, 82, 0.55);
    border-radius: 50%;
    color: var(--gold-dark);
    font-weight: 900;
  }

  .process-line h3 {
    margin-bottom: 8px;
    font-size: 1.05rem;
  }

  .process-line p {
    color: var(--muted);
    font-size: 0.84rem;
  }

  .proof-section {
    background: #fffaf1;
  }


  .instagram-section {
    padding-top: 56px;
  }

  .instagram-section h2 {
    font-size: 1.7rem;
  }

  .instagram-row {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 16px;
    margin-top: 30px;
  }

  .instagram-tile {
    display: block;
    aspect-ratio: 1.3;
    overflow: hidden;
    border-radius: 4px;
    background: var(--soft);
    box-shadow: 0 10px 24px rgba(38, 23, 15, 0.08);
  }

  .instagram-row :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 220ms ease;
  }

  .instagram-tile:hover :global(img) {
    transform: scale(1.05);
  }

  .areas-section {
    background: #fffaf1;
  }

  .areas-lead {
    max-width: 70ch;
  }

  .areas-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
  }

  .areas-list li {
    padding: 7px 16px;
    border: 1px solid rgba(217, 173, 82, 0.5);
    border-radius: 999px;
    background: #fff;
    color: var(--ink);
    font-size: 0.86rem;
    font-weight: 700;
  }

  .areas-services {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 18px;
    margin-top: 26px;
  }

  .areas-services a {
    color: var(--muted);
    font-size: 0.84rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .areas-services a:hover {
    color: var(--gold-dark);
  }

  .whatsapp-band {
    padding: 26px 0;
    background: #fff;
  }

  .whatsapp-card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 22px;
    border-radius: 4px;
    padding: 28px 36px;
    background:
      linear-gradient(135deg, rgba(111, 24, 50, 0.96), rgba(72, 16, 34, 0.96)),
      radial-gradient(circle at 0 0, rgba(217, 173, 82, 0.28), transparent 30%);
    color: #fff8ec;
  }

  .wa-icon {
    width: 70px;
    height: 70px;
    display: grid;
    place-items: center;
    border: 2px solid rgba(255, 255, 255, 0.62);
    border-radius: 50%;
    font-size: 2rem;
  }

  .whatsapp-card h2 {
    margin-bottom: 6px;
    font-size: 1.75rem;
  }

  .whatsapp-card p {
    margin: 0;
    color: rgba(255, 248, 236, 0.78);
  }

  .contact-section {
    background: var(--soft);
  }

  @media (max-width: 980px) {
    .service-strip {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .masonry-gallery {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .why-grid,
    .process-line,
    .highlight-grid {
      grid-template-columns: 1fr;
    }

    .process-line article:not(:last-child)::after {
      display: none;
    }

    .instagram-row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .ornament {
      margin-bottom: 24px;
    }

    .signature-services {
      overflow: hidden;
    }

    .service-strip {
      width: calc(100% + 24px);
      display: flex;
      gap: 12px;
      margin-inline: -12px;
      overflow-x: auto;
      padding: 0 12px 8px;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .service-strip::-webkit-scrollbar {
      display: none;
    }

    .service-tile {
      min-width: min(76vw, 270px);
      min-height: 214px;
      scroll-snap-align: start;
    }

    .service-tile strong {
      min-height: 56px;
      padding: 12px;
      font-size: 0.95rem;
    }

    .masonry-gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: clamp(126px, 38vw, 156px);
    }

    .masonry-gallery figure.wide {
      grid-column: span 2;
    }

    .masonry-gallery figure.tall {
      grid-row: span 1;
    }

    .why-grid {
      gap: 14px;
      margin-top: 32px;
      text-align: left;
    }

    .why-grid article {
      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: 14px;
      align-items: start;
      padding: 16px;
      border: 1px solid rgba(217, 173, 82, 0.18);
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.06);
    }

    .reason-icon {
      grid-row: span 2;
      width: 40px;
      height: 40px;
      margin: 0;
    }

    .why-grid h3 {
      margin: 0 0 5px;
      font-size: 1.02rem;
    }

    .why-grid p {
      font-size: 0.86rem;
      line-height: 1.45;
    }

    .process-line {
      gap: 12px;
      margin-top: 32px;
      text-align: left;
    }

    .process-line article {
      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: 14px;
      align-items: center;
      padding: 14px;
      border: 1px solid var(--line);
      border-radius: 6px;
      background: #fffdf8;
      box-shadow: 0 10px 28px rgba(38, 23, 15, 0.05);
    }

    .process-icon {
      grid-row: span 2;
      width: 52px;
      height: 52px;
      margin: 0;
      font-size: 0.86rem;
    }

    .process-line h3,
    .process-line p {
      margin: 0;
    }

    .process-line p {
      margin-top: 4px;
