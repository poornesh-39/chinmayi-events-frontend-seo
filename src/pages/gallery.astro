---
import BaseLayout from '../layouts/BaseLayout.astro';
import LiveGallery from '../components/LiveGallery.jsx';
import IslandStyles from '../components/IslandStyles.astro';
import { site, siteUrl } from '../data/site.js';
import { getGalleryItems, galleryImageUrls } from '../data/live-content.js';
import { breadcrumbSchema } from '../data/schema.js';

// Fetched at build time so the photos are in the HTML a crawler reads, not
// only in the island's mount-time fetch.
const galleryItems = await getGalleryItems();
const indexableImages = galleryImageUrls(galleryItems, 60);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Chinmayi Events Gallery',
  description: 'Wedding, reception, birthday, engagement and theme decoration gallery from Chinmayi Events in Chikkamagaluru.',
  url: new URL('/gallery/', siteUrl).toString(),
  isPartOf: {
    '@type': 'WebSite',
    name: site.name,
    url: siteUrl
  },
  ...(indexableImages.length > 0 && {
    mainEntity: {
      '@type': 'ImageGallery',
      name: 'Chinmayi Events decoration gallery',
      image: indexableImages.map((item) => ({
        '@type': 'ImageObject',
        contentUrl: item.url,
        name: item.title,
        creditText: site.name
      }))
    }
  })
};
---

<BaseLayout
  title="Event Decoration Gallery in Chikkamagaluru | Chinmayi Events"
  description="View Chinmayi Events wedding decoration, reception stage, birthday decor, flower theme and shamiyana setup work in Chikkamagaluru."
  canonical="/gallery/"
  jsonLd={[schema, breadcrumbSchema([['Gallery', '/gallery/']])]}
>
  <IslandStyles />
  <section class="interior-hero" style="--page-hero-image: url('/images/opt/chikkamagaluru-gallery-night-stage-10-1200.webp')">
    <div class="container">
      <p class="eyebrow">Gallery</p>
      <h1>Decoration work from real celebrations.</h1>
      <p class="lead">
        Browse featured Chinmayi Events decor and view recent photos by
        event category.
      </p>
      <div class="hero-kicker-row">
        <span>Wedding stages</span>
        <span>Outdoor mandaps</span>
        <span>Floral themes</span>
        <span>Recent photos</span>
      </div>
    </div>
  </section>

  <section class="section live-gallery-section">
    <div class="container centered">
      <p class="eyebrow">Event gallery</p>
      <h2 class="section-title">Real celebrations, neatly organized by event type</h2>
      <LiveGallery client:load initialItems={galleryItems} />
    </div>
  </section>
</BaseLayout>

<style>
  .live-gallery-section {
    background: linear-gradient(180deg, #fffdf8, #fbf7ef);
  }
</style>

