---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyActions from '../components/StickyActions.astro';
import { site, siteUrl } from '../data/site.js';
import { responsiveImage } from '../data/images.js';

const {
  title = `${site.tagline} | ${site.name}`,
  description = site.description,
  canonical = Astro.url.pathname,
  image = site.ogImage,
  jsonLd = [],
  preloadHero = false,
  noindex = false
} = Astro.props;

const heroImage = responsiveImage(site.heroImage);
const canonicalUrl = new URL(canonical, siteUrl).toString();
const imageUrl = new URL(image, siteUrl).toString();
const ldItems = Array.isArray(jsonLd) ? jsonLd : [jsonLd];
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#6e1f2f" />

    <!-- global.css asks for Inter; without this it silently fell back to a system font. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400..900&display=swap"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/images/opt/chinmayi-events-logo-64.webp" type="image/webp" />
    <link rel="apple-touch-icon" href="/images/opt/chinmayi-events-logo-256.jpg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {preloadHero && (
      <link
        rel="preload"
        as="image"
        type="image/webp"
        href={heroImage.src}
        imagesrcset={heroImage.webpSrcSet}
        imagesizes="100vw"
        fetchpriority="high"
      />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    {ldItems.map((item) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <StickyActions />
  </body>
</html>





