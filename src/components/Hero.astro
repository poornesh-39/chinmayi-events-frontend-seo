---
import { site, whatsappHref, gmailHref } from '../data/site.js';
import SmartImage from './SmartImage.astro';
---

<section class="hero">
  <div class="hero-media">
    <SmartImage
      src={site.heroImage}
      alt="Premium wedding stage decoration by Chinmayi Events in Chikkamagaluru"
      width="1600"
      height="2400"
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="hero-shade"></div>
  <div class="container hero-content">
    <p class="eyebrow">We create, you celebrate</p>
    <h1>Event Management &amp; Decoration<br />in Chikkamagaluru</h1>
    <p class="signature">Creating beautiful memories across Karnataka</p>
    <p class="hero-copy">
      Weddings, receptions, haldi, naming ceremonies, housewarming, birthdays
      and corporate events, crafted with elegance and set up on time.
    </p>
    <div class="btn-row">
      <a class="button button-primary" href="/gallery/">View Our Work</a>
      <a class="button button-ghost" href={whatsappHref()} target="_blank" rel="noopener noreferrer">Book Consultation</a>
    </div>
    <div class="hero-bottom" aria-label="Hero slide indicator">
      <span>01</span>
      <i></i>
      <span>03</span>
    </div>
  </div>
  <div class="social-rail" aria-label="Social links">
    <a class="social-icon" href={site.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M7.8 2.8h8.4a5 5 0 0 1 5 5v8.4a5 5 0 0 1-5 5H7.8a5 5 0 0 1-5-5V7.8a5 5 0 0 1 5-5Zm0 2a3 3 0 0 0-3 3v8.4a3 3 0 0 0 3 3h8.4a3 3 0 0 0 3-3V7.8a3 3 0 0 0-3-3H7.8Zm4.2 3.1a4.1 4.1 0 1 1 0 8.2 4.1 4.1 0 0 1 0-8.2Zm0 2a2.1 2.1 0 1 0 0 4.2 2.1 2.1 0 0 0 0-4.2Zm5.1-2.6a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0Z" />
      </svg>
    </a>
    <a class="social-icon" href={whatsappHref()} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12.1 2.4a9.5 9.5 0 0 0-8.2 14.3L2.8 21.6l5-1.3a9.5 9.5 0 1 0 4.3-17.9Zm0 2a7.5 7.5 0 1 1-3.7 14l-.4-.2-2.5.7.6-2.4-.3-.4a7.5 7.5 0 0 1 6.3-11.7Zm-3 4.1c-.2.2-.8.8-.8 1.9s.8 2.2 1 2.4c.1.2 1.7 2.7 4.3 3.7 2.1.8 2.5.5 3 .5.5 0 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.2-.2-.5-.4l-1.7-.8c-.2-.1-.4-.1-.6.1l-.7.9c-.1.2-.3.2-.6.1-.3-.1-1.1-.4-2-1.2-.8-.7-1.3-1.5-1.5-1.8-.2-.3 0-.4.1-.6l.4-.5c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5L11 8.9c-.2-.5-.4-.5-.6-.5h-.5c-.2 0-.5.1-.8.4Z" />
      </svg>
    </a>
    <a class="social-icon" href={gmailHref()} target="_blank" rel="noopener noreferrer" aria-label="Gmail">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4.8 5.5h14.4c1 0 1.8.8 1.8 1.8v9.4c0 1-.8 1.8-1.8 1.8H4.8c-1 0-1.8-.8-1.8-1.8V7.3c0-1 .8-1.8 1.8-1.8Zm.2 3v8h14v-8l-7 5.1-7-5.1Zm1.4-1L12 11.6l5.6-4.1H6.4Z" />
      </svg>
    </a>
  </div>
</section>

<style>
  .hero {
    min-height: 720px;
    height: 100vh;
    position: relative;
    display: grid;
    align-items: center;
    overflow: hidden;
    background: var(--black);
  }

  .hero-media,
  .hero-shade {
    position: absolute;
    inset: 0;
  }

  .hero-media :global(picture),
  .hero-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-shade {
    background:
      radial-gradient(circle at 70% 32%, rgba(217, 173, 82, 0.12), transparent 28%),
      linear-gradient(90deg, rgba(0, 0, 0, 0.9), rgba(0, 0, 0, 0.55) 42%, rgba(0, 0, 0, 0.24)),
      linear-gradient(0deg, rgba(0, 0, 0, 0.82), rgba(0, 0, 0, 0.08) 44%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding-top: 86px;
    color: #fff9ee;
  }

  .eyebrow {
    color: var(--gold);
  }

  h1 {
    max-width: 16ch;
    margin: 18px 0 10px;
    font-size: clamp(2.6rem, 5.4vw, 4.6rem);
    line-height: 1.04;
    text-shadow: 0 12px 42px rgba(0, 0, 0, 0.44);
  }

  .signature {
    margin: 0 0 18px;
    color: var(--gold);
    font-family: "Brush Script MT", "Segoe Script", cursive;
    font-size: clamp(1.4rem, 2.3vw, 2.25rem);
    line-height: 1.15;
  }

  /* Matches the .eyebrow treatment above the headline — same size, weight,
     tracking and uppercase — set in white so the two read as a pair rather
     than as one label. Uppercase at 0.14em tracking runs roughly a third
     wider than sentence case and wraps to several lines here, so the measure
     and leading are opened up to keep it scannable. */
  .hero-copy {
    max-width: 44ch;
    margin-bottom: 28px;
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    line-height: 2;
    text-transform: uppercase;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.55);
  }

  .hero-bottom {
    position: absolute;
    left: 0;
    bottom: -145px;
    display: flex;
    align-items: center;
    gap: 13px;
    color: #fff8ec;
    font-size: 0.76rem;
    font-weight: 900;
  }

  .hero-bottom i {
    display: block;
    width: 74px;
    height: 2px;
    background: linear-gradient(90deg, var(--gold), rgba(255,255,255,0.35));
  }

  .social-rail {
    position: absolute;
    right: 32px;
    top: 42%;
    z-index: 2;
    display: grid;
    gap: 12px;
  }

  .social-icon {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(217, 173, 82, 0.55);
    border-radius: 50%;
    color: #fff8ec;
    background: rgba(0, 0, 0, 0.52);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.22);
    transition: border-color 160ms ease, color 160ms ease, transform 160ms ease, background 160ms ease;
  }

  .social-icon:hover {
    border-color: var(--gold);
    color: #231608;
    background: var(--gold);
    transform: translateY(-1px);
  }

  .social-icon svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
    stroke: none;
  }

  @media (max-width: 760px) {
    /* Match the interior-page hero proportions instead of filling the viewport,
       so the services and CTAs sit closer to the fold. */
    .hero {
      min-height: 520px;
      height: auto;
      align-items: end;
      padding: 128px 0 76px;
    }

    .hero-media :global(img) {
      object-position: 58% center;
    }

    .hero-shade {
      background:
        linear-gradient(0deg, rgba(0, 0, 0, 0.94), rgba(0, 0, 0, 0.52) 48%, rgba(0, 0, 0, 0.18)),
        linear-gradient(90deg, rgba(0, 0, 0, 0.78), rgba(0, 0, 0, 0.18));
    }

    .hero-content {
      width: min(100% - 28px, 1180px);
      padding: 0;
      transform: none;
    }

    h1 {
      max-width: 14ch;
      margin-top: 14px;
      font-size: clamp(2.15rem, 9.2vw, 3.1rem);
      line-height: 1.06;
    }

    .signature {
      max-width: 22ch;
      margin-bottom: 14px;
      font-size: clamp(1.2rem, 5.4vw, 1.6rem);
    }

    .hero-copy {
      max-width: 30ch;
      margin-bottom: 22px;
      font-size: 0.7rem;
      letter-spacing: 0.12em;
      line-height: 1.95;
    }

    .btn-row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      width: min(100%, 360px);
    }

    .btn-row .button {
      min-height: 46px;
      padding-inline: 9px;
      font-size: 0.68rem;
      letter-spacing: 0.035em;
      white-space: nowrap;
    }

    .social-rail {
      right: auto;
      left: 50%;
      top: auto;
      bottom: 18px;
      grid-auto-flow: column;
      transform: translateX(-50%);
    }

    .social-icon {
      width: 42px;
      height: 42px;
    }

    .hero-bottom {
      display: none;
    }
  }

  @media (max-width: 390px) {
    .hero {
      min-height: 470px;
      padding: 116px 0 72px;
    }

    h1 {
      font-size: clamp(1.95rem, 8.6vw, 2.5rem);
    }

    .hero-copy {
      font-size: 0.66rem;
      letter-spacing: 0.1em;
      line-height: 1.9;
    }

    .btn-row {
      gap: 7px;
    }

    .btn-row .button {
      font-size: 0.62rem;
      padding-inline: 7px;
    }
  }
</style>
