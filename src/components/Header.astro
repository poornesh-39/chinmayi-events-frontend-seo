---
import { site, whatsappHref } from '../data/site.js';

const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  if (href === '/services/') return pathname.startsWith('/services/');
  return pathname === href;
};

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About Us' },
  { href: '/services/', label: 'Services' },
  { href: '/gallery/', label: 'Gallery' },
  { href: '/#testimonials', label: 'Testimonials', active: pathname === '/' && Astro.url.hash === '#testimonials' },
  { href: '/contact/', label: 'Contact Us' }
];
---

<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/" aria-label="Chinmayi Events home">
      <img
        src="/images/opt/chinmayi-events-logo-128.webp"
        srcset="/images/opt/chinmayi-events-logo-64.webp 64w, /images/opt/chinmayi-events-logo-128.webp 128w, /images/opt/chinmayi-events-logo-256.webp 256w"
        sizes="54px"
        alt="Chinmayi Events logo"
        width="54"
        height="54"
        fetchpriority="high"
      />
      <span>Chinmayi Events</span>
    </a>
    <nav aria-label="Primary navigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[isActive(item.href) || item.active ? 'active' : '']}
          aria-current={isActive(item.href) || item.active ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <button
      type="button"
      class="menu-toggle"
      id="menu-toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="menu-bars" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>
  </div>
</header>

<div class="menu-backdrop" id="menu-backdrop" hidden></div>

<div class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Site menu" hidden>
  <div class="mobile-menu-head">
    <a class="mm-brand" href="/">
      <img
        class="mm-logo"
        src="/images/opt/chinmayi-events-logo-128.webp"
        srcset="/images/opt/chinmayi-events-logo-64.webp 64w, /images/opt/chinmayi-events-logo-128.webp 128w"
        sizes="46px"
        alt="Chinmayi Events logo"
        width="46"
        height="46"
        loading="lazy"
      />
      <span class="mm-brand-text">
        <strong>Chinmayi Events</strong>
        <small>{site.tagline}</small>
      </span>
    </a>
    <button type="button" class="menu-close" id="menu-close" aria-label="Close menu">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </div>

  <nav class="mobile-nav" aria-label="Mobile navigation">
    {navItems.map((item) => (
      <a
        href={item.href}
        aria-current={isActive(item.href) || item.active ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>

  <div class="mobile-menu-foot">
    <a class="mm-call" href={`tel:${site.phonePrimary}`}>Call {site.phonePrimaryLabel}</a>
    <a class="mm-wa" href={whatsappHref()} target="_blank" rel="noopener noreferrer">WhatsApp</a>
    <p class="mm-hours">{site.openingHoursLabel}</p>
  </div>
</div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const closeBtn = document.getElementById('menu-close');
  const backdrop = document.getElementById('menu-backdrop');
  const menu = document.getElementById('mobile-menu');

  if (toggle && closeBtn && backdrop && menu) {
    const FOCUSABLE = 'a[href], button:not([disabled])';
    let lastFocused: HTMLElement | null = null;

    const isOpen = () => document.body.classList.contains('menu-open');

    const openMenu = () => {
      lastFocused = document.activeElement as HTMLElement;
      menu.hidden = false;
      backdrop.hidden = false;
      // Force a reflow so the transition runs from the hidden state.
      void menu.offsetWidth;
      document.body.classList.add('menu-open');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close menu');
      (menu.querySelector(FOCUSABLE) as HTMLElement | null)?.focus();
    };

    const closeMenu = () => {
      document.body.classList.remove('menu-open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open menu');
      window.setTimeout(() => {
        if (!isOpen()) {
          menu.hidden = true;
          backdrop.hidden = true;
        }
      }, 320);
      lastFocused?.focus();
    };

    toggle.addEventListener('click', () => (isOpen() ? closeMenu() : openMenu()));
    closeBtn.addEventListener('click', closeMenu);
    backdrop.addEventListener('click', closeMenu);

    // Same-page hash links do not trigger navigation, so close the drawer manually.
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));

    document.addEventListener('keydown', (event) => {
      if (!isOpen()) return;

      if (event.key === 'Escape') {
        closeMenu();
        return;
      }

      if (event.key !== 'Tab') return;

      const items = Array.from(menu.querySelectorAll<HTMLElement>(FOCUSABLE));
      if (items.length === 0) return;

      const first = items[0];
      const last = items[items.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    // Reset state if the viewport grows back to the desktop nav.
    window.matchMedia('(min-width: 981px)').addEventListener('change', (event) => {
      if (event.matches && isOpen()) closeMenu();
    });
  }
</script>

<style>
  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 30;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.72), rgba(0, 0, 0, 0));
  }

  .nav {
    min-height: 82px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--gold);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.52rem;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }

  .brand img {
    width: 54px;
    height: 54px;
    object-fit: contain;
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, 26px);
    color: rgba(255, 248, 236, 0.72);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  nav a {
    position: relative;
    padding: 30px 0 18px;
    transition: color 160ms ease;
  }

  nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 10px;
    height: 2px;
    transform: scaleX(0);
    transform-origin: center;
    background: linear-gradient(90deg, var(--gold), var(--gold-dark));
    transition: transform 180ms ease;
  }

  nav a.active,
  nav a:hover {
    color: var(--gold);
  }

  nav a.active::after,
  nav a:hover::after {
    transform: scaleX(1);
  }


  /* ---- Mobile menu ---- */

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    flex: 0 0 auto;
    place-items: center;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: #fff8ec;
    cursor: pointer;
  }

  .menu-bars {
    display: grid;
    gap: 5px;
    width: 22px;
  }

  .menu-bars i {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 200ms ease, opacity 160ms ease;
  }

  :global(body.menu-open) .menu-bars i:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  :global(body.menu-open) .menu-bars i:nth-child(2) {
    opacity: 0;
  }

  :global(body.menu-open) .menu-bars i:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Author styles beat the UA [hidden] rule, so re-assert it explicitly —
     otherwise the transparent backdrop stays in the layer and eats every tap. */
  .mobile-menu[hidden],
  .menu-backdrop[hidden] {
    display: none;
  }

  .menu-backdrop {
    position: fixed;
    inset: 0;
    z-index: 55;
    background: rgba(15, 12, 10, 0.34);
    -webkit-backdrop-filter: blur(9px) saturate(120%);
    backdrop-filter: blur(9px) saturate(120%);
    opacity: 0;
    transition: opacity 220ms ease;
  }

  :global(body.menu-open) .menu-backdrop {
    opacity: 1;
  }

  .mobile-menu {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    width: min(300px, 84vw);
    display: flex;
    flex-direction: column;
    padding: 18px 20px calc(22px + env(safe-area-inset-bottom));
    background: linear-gradient(180deg, #fffdf8, #fbf6ee);
    border-left: 1px solid var(--line);
    box-shadow: -18px 0 48px rgba(38, 23, 15, 0.22);
    color: var(--ink);
    overflow-y: auto;
    overscroll-behavior: contain;
    transform: translateX(100%);
    transition: transform 220ms ease;
  }

  :global(body.menu-open) .mobile-menu {
    transform: translateX(0);
  }

  .mobile-menu-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }

  .mm-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .mm-logo {
    width: 46px;
    height: 46px;
    flex: 0 0 auto;
    object-fit: contain;
  }

  .mm-brand-text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  /* Same serif lockup as the desktop brand mark. Sized to the narrower panel:
     "Chinmayi Events" is ~9.2em wide in Georgia, so at this width it is what
     sets the floor on how narrow the drawer can go. The ellipsis is a guard —
     if the serif stack ever falls back to something wider, the name truncates
     instead of pushing the close button off the panel. */
  .mm-brand-text strong {
    color: var(--maroon);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mm-brand-text small {
    color: var(--gold-dark);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .menu-close {
    width: 40px;
    height: 40px;
    flex: 0 0 auto;
    margin-right: -8px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  .menu-close svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  /* Grouped directly under the logo rather than spread down the panel. */
  .mobile-nav {
    display: grid;
    /* Sets the space under the brand rule. The first link adds its own 5px of
       padding on top of this, so the visible gap is 5px more than the value
       here. */
    padding: 18px 0 2px;
  }

  /* Matches the desktop nav: uppercase and tracked. No rules between rows and
     no current-page marker — the row height alone carries the separation. */
  .mobile-nav a {
    display: block;
    /* Exactly 10px between adjacent titles: 5px below one row plus 5px above
       the next. Done with padding rather than a grid gap so the tap areas stay
       contiguous — a gap would leave each link a bare 15px island. */
    padding: 5px 0;
    color: var(--ink);
    font-size: 0.74rem;
    font-weight: 900;
    /* Pinned rather than inherited from the 1.55 body value, so the spacing
       comes from the padding and not from an invisible line box. */
    line-height: 1.25;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .mobile-menu-foot {
    display: grid;
    gap: 10px;
    margin-top: auto;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .mobile-menu-foot a {
    min-height: 46px;
    display: grid;
    place-items: center;
    border-radius: 4px;
    padding: 11px 12px;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase;
  }

  .mm-call {
    background: linear-gradient(135deg, var(--maroon), #4a1020);
    color: #fff8ec;
  }

  .mm-wa {
    border: 1px solid var(--line);
    background: #fff;
    color: var(--ink);
  }

  .mm-hours {
    margin: 2px 0 0;
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    .menu-backdrop,
    .menu-bars i {
      transition: none;
    }
  }

  @media (max-width: 980px) {
    nav {
      display: none;
    }

    .menu-toggle {
      display: grid;
    }

    /* Drops the whole bar rather than just the brand, so the logo and the
       menu button stay on one line as they move down. */
    .nav {
      padding-top: 10px;
    }
  }

  @media (min-width: 981px) {
    .mobile-menu,
    .menu-backdrop {
      display: none;
    }

    /* Row stays centred — top-aligning it lifted the links ~8px. To lower the
       logo without raising the links, the whole bar is dropped instead. */
    .nav {
      padding-top: 10px;
    }

    /* `nav a` is padded 30px top against 18px bottom, so its text sits
       (30 - 18) / 2 = 6px below the row's centre line. The brand takes the
       same offset so the two share one centre line, whatever the font metrics
       turn out to be. */
    .brand {
      position: relative;
      top: 6px;
    }
  }

  @media (max-width: 620px) {
    .site-header {
      position: absolute;
    }

    .nav {
      min-height: 70px;
      gap: 12px;
    }

    .brand {
      gap: 8px;
      font-size: clamp(1.14rem, 6vw, 1.42rem);
    }

    .brand img {
      width: 46px;
      height: 46px;
    }

    .menu-toggle {
      width: 44px;
      height: 44px;
    }
  }
</style>
