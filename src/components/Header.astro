---
import { site, whatsappHref } from '../data/site.js';

const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  if (href === '/services/') return pathname.startsWith('/services/');
  return pathname === href;
};

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About Us' },
  { href: '/services/', label: 'Services' },
  { href: '/gallery/', label: 'Gallery' },
  { href: '/#testimonials', label: 'Testimonials', active: pathname === '/' && Astro.url.hash === '#testimonials' },
  { href: '/contact/', label: 'Contact Us' }
];
---

<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/" aria-label="Chinmayi Events home">
      <img
        src="/images/opt/chinmayi-events-logo-128.webp"
        srcset="/images/opt/chinmayi-events-logo-64.webp 64w, /images/opt/chinmayi-events-logo-128.webp 128w, /images/opt/chinmayi-events-logo-256.webp 256w"
        sizes="54px"
        alt="Chinmayi Events logo"
        width="54"
        height="54"
        fetchpriority="high"
      />
      <span>Chinmayi Events</span>
    </a>
    <nav aria-label="Primary navigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[isActive(item.href) || item.active ? 'active' : '']}
          aria-current={isActive(item.href) || item.active ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <button
      type="button"
      class="menu-toggle"
      id="menu-toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="menu-bars" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>
  </div>
</header>

<div class="menu-backdrop" id="menu-backdrop" hidden></div>

<div class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Site menu" hidden>
  <div class="mobile-menu-head">
    <img
      class="mm-logo"
      src="/images/opt/chinmayi-events-logo-128.webp"
      alt="Chinmayi Events"
      width="42"
      height="42"
      loading="lazy"
    />
    <button type="button" class="menu-close" id="menu-close" aria-label="Close menu">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </div>

  <nav class="mobile-nav" aria-label="Mobile navigation">
    {navItems.map((item) => (
      <a
        href={item.href}
        class:list={[isActive(item.href) || item.active ? 'active' : '']}
        aria-current={isActive(item.href) || item.active ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>

  <div class="mobile-menu-foot">
    <a class="mm-call" href={`tel:${site.phonePrimary}`}>Call {site.phonePrimaryLabel}</a>
    <a class="mm-wa" href={whatsappHref()} target="_blank" rel="noopener noreferrer">WhatsApp</a>
  </div>
</div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const closeBtn = document.getElementById('menu-close');
  const backdrop = document.getElementById('menu-backdrop');
  const menu = document.getElementById('mobile-menu');

  if (toggle && closeBtn && backdrop && menu) {
    const FOCUSABLE = 'a[href], button:not([disabled])';
    let lastFocused: HTMLElement | null = null;

    const isOpen = () => document.body.classList.contains('menu-open');

    const openMenu = () => {
      lastFocused = document.activeElement as HTMLElement;
      menu.hidden = false;
      backdrop.hidden = false;
      // Force a reflow so the transition runs from the hidden state.
      void menu.offsetWidth;
      document.body.classList.add('menu-open');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close menu');
      (menu.querySelector(FOCUSABLE) as HTMLElement | null)?.focus();
    };

    const closeMenu = () => {
      document.body.classList.remove('menu-open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open menu');
      window.setTimeout(() => {
        if (!isOpen()) {
          menu.hidden = true;
          backdrop.hidden = true;
        }
      }, 320);
      lastFocused?.focus();
    };

    toggle.addEventListener('click', () => (isOpen() ? closeMenu() : openMenu()));
    closeBtn.addEventListener('click', closeMenu);
    backdrop.addEventListener('click', closeMenu);

    // Same-page hash links do not trigger navigation, so close the drawer manually.
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));

    document.addEventListener('keydown', (event) => {
      if (!isOpen()) return;

      if (event.key === 'Escape') {
        closeMenu();
        return;
      }

      if (event.key !== 'Tab') return;

      const items = Array.from(menu.querySelectorAll<HTMLElement>(FOCUSABLE));
      if (items.length === 0) return;

      const first = items[0];
      const last = items[items.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    // Reset state if the viewport grows back to the desktop nav.
    window.matchMedia('(min-width: 981px)').addEventListener('change', (event) => {
      if (event.matches && isOpen()) closeMenu();
    });
  }
</script>

<style>
  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 30;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.72), rgba(0, 0, 0, 0));
  }

  .nav {
    min-height: 82px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--gold);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.52rem;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }

  .brand img {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    object-fit: cover;
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, 26px);
    color: rgba(255, 248, 236, 0.72);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  nav a {
    position: relative;
    padding: 30px 0 18px;
    transition: color 160ms ease;
  }

  nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 10px;
    height: 2px;
    transform: scaleX(0);
    transform-origin: center;
    background: linear-gradient(90deg, var(--gold), var(--gold-dark));
    transition: transform 180ms ease;
  }

  nav a.active,
  nav a:hover {
    color: var(--gold);
  }

  nav a.active::after,
  nav a:hover::after {
    transform: scaleX(1);
  }


  /* ---- Mobile menu ---- */

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    flex: 0 0 auto;
    place-items: center;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: #fff8ec;
    cursor: pointer;
  }

  .menu-bars {
    display: grid;
    gap: 5px;
    width: 22px;
  }

  .menu-bars i {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 200ms ease, opacity 160ms ease;
  }

  :global(body.menu-open) .menu-bars i:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  :global(body.menu-open) .menu-bars i:nth-child(2) {
    opacity: 0;
  }

  :global(body.menu-open) .menu-bars i:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Author styles beat the UA [hidden] rule, so re-assert it explicitly —
     otherwise the transparent backdrop stays in the layer and eats every tap. */
  .mobile-menu[hidden],
  .menu-backdrop[hidden] {
    display: none;
  }

  .menu-backdrop {
    position: fixed;
    inset: 0;
    z-index: 55;
    background: rgba(15, 12, 10, 0.4);
    opacity: 0;
    transition: opacity 200ms ease;
  }

  :global(body.menu-open) .menu-backdrop {
    opacity: 1;
  }

  .mobile-menu {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    width: min(300px, 82vw);
    display: flex;
    flex-direction: column;
    padding: 14px 20px calc(20px + env(safe-area-inset-bottom));
    background: #fff;
    box-shadow: -8px 0 32px rgba(38, 23, 15, 0.14);
    overflow-y: auto;
    overscroll-behavior: contain;
    transform: translateX(100%);
    transition: transform 220ms ease;
  }

  :global(body.menu-open) .mobile-menu {
    transform: translateX(0);
  }

  .mobile-menu-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .mm-logo {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    object-fit: cover;
  }

  .menu-close {
    width: 40px;
    height: 40px;
    margin-right: -8px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  .menu-close svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  /* Grouped directly under the logo rather than spread down the panel. */
  .mobile-nav {
    display: grid;
    gap: 2px;
    padding: 4px 0;
  }

  .mobile-nav a {
    min-height: 42px;
    display: flex;
    align-items: center;
    /* Transparent on every row so the active marker adds no layout shift. */
    border-left: 2px solid transparent;
    padding-left: 14px;
    margin-left: -16px;
    color: var(--ink);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.005em;
  }

  .mobile-nav a.active {
    border-left-color: var(--maroon);
    color: var(--maroon);
  }

  .mobile-menu-foot {
    display: grid;
    gap: 9px;
    margin-top: auto;
    padding-top: 20px;
  }

  .mobile-menu-foot a {
    min-height: 46px;
    display: grid;
    place-items: center;
    border-radius: 6px;
    padding: 11px 12px;
    font-size: 0.82rem;
    font-weight: 800;
    text-align: center;
  }

  .mm-call {
    background: var(--maroon);
    color: #fff8ec;
  }

  .mm-wa {
    border: 1px solid var(--line);
    color: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    .menu-backdrop,
    .menu-bars i {
      transition: none;
    }
  }

  @media (max-width: 980px) {
    nav {
      display: none;
    }

    .menu-toggle {
      display: grid;
    }
  }

  @media (min-width: 981px) {
    .mobile-menu,
    .menu-backdrop {
      display: none;
    }
  }

  @media (max-width: 620px) {
    .site-header {
      position: absolute;
    }

    .nav {
      min-height: 70px;
      gap: 12px;
    }

    .brand {
      gap: 8px;
      font-size: clamp(1.14rem, 6vw, 1.42rem);
    }

    .brand img {
      width: 46px;
      height: 46px;
    }

    .menu-toggle {
      width: 44px;
      height: 44px;
    }
  }
</style>
