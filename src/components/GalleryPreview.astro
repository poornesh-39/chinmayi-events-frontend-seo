---
import { galleryHighlights } from '../data/site.js';

const { compact = false } = Astro.props;
const highlights = compact ? galleryHighlights.slice(0, 4) : galleryHighlights;
---

<div class="gallery-grid">
  {highlights.map((item, index) => (
    <figure class:list={['gallery-item', index === 0 && !compact ? 'featured' : '']}>
      <img src={item.src} alt={item.alt} loading={index === 0 ? 'eager' : 'lazy'} width="800" height="620" />
      <figcaption>{item.title}</figcaption>
    </figure>
  ))}
</div>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  .gallery-item {
    position: relative;
    min-height: 240px;
    margin: 0;
    border-radius: 8px;
    overflow: hidden;
    background: var(--soft);
  }

  .featured {
    grid-column: span 2;
    grid-row: span 2;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 220ms ease;
  }

  .gallery-item:hover img {
    transform: scale(1.035);
  }

  figcaption {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    border-radius: 8px;
    padding: 9px 11px;
    background: rgba(64, 17, 27, 0.82);
    color: #fff8ec;
    font-weight: 800;
  }

  @media (max-width: 860px) {
    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .featured {
      grid-column: span 2;
    }
  }

  @media (max-width: 560px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }

    .featured {
      grid-column: span 1;
    }
  }
</style>
