<style is:global>
  .lead-form {
    display: grid;
    gap: 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 24px;
    background: #fff;
    box-shadow: var(--shadow);
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .lead-form label {
    display: grid;
    gap: 7px;
    color: var(--ink);
    font-weight: 800;
  }

  .lead-form input,
  .lead-form select,
  .lead-form textarea {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 12px 13px;
    background: #fffdf8;
    color: var(--ink);
  }

  .lead-form textarea {
    resize: vertical;
  }

  .lead-form button {
    border: 0;
    border-radius: 8px;
    padding: 14px 18px;
    background: var(--maroon);
    color: #fff;
    font-weight: 900;
    cursor: pointer;
  }

  .lead-form button:disabled {
    opacity: 0.7;
    cursor: wait;
  }

  .status {
    margin: 0;
    font-weight: 750;
  }

  .status.success {
    color: #0f6a3f;
  }

  .status.error {
    color: #9c1d2a;
  }

  .live-note {
    margin: 0;
    color: var(--muted);
    font-weight: 750;
  }

  .recent-gallery-wrap {
    display: grid;
    gap: 24px;
  }

  .gallery-filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }

  .gallery-filter-row button {
    border: 1px solid rgba(91, 23, 48, 0.16);
    background: #fffaf1;
    color: var(--maroon-dark);
    min-height: 38px;
    padding: 0 14px;
    border-radius: 999px;
    font: inherit;
    font-size: 0.86rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 160ms ease, border-color 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .gallery-filter-row button:hover,
  .gallery-filter-row button.active {
    background: var(--maroon);
    border-color: var(--maroon);
    color: #fffaf1;
    transform: translateY(-1px);
  }

  .live-gallery {
    column-count: 4;
    column-gap: 10px;
  }

  .live-gallery figure {
    margin: 0 0 10px;
    break-inside: avoid;
    overflow: hidden;
    border-radius: 4px;
    background: var(--soft);
    box-shadow: 0 10px 26px rgba(38, 23, 15, 0.08);
  }

  .live-gallery img,
  .live-gallery video {
    width: 100%;
    height: auto;
    display: block;
  }

  .live-gallery img {
    transition: transform 220ms ease;
  }

  .live-gallery figure:hover img {
    transform: scale(1.02);
  }

  .live-gallery video {
    background: #090807;
  }

  @media (max-width: 980px) {
    .live-gallery {
      column-count: 3;
    }
  }

  @media (max-width: 760px) {
    .form-grid {
      grid-template-columns: 1fr;
    }

    .lead-form {
      padding: 18px;
    }

    .lead-form input,
    .lead-form select,
    .lead-form textarea {
      min-height: 48px;
      font-size: 16px;
    }

    .lead-form button {
      min-height: 50px;
    }

    .live-gallery {
      column-count: 2;
      column-gap: 8px;
    }

    .live-gallery figure {
      margin-bottom: 8px;
    }

    .gallery-filter-row {
      justify-content: flex-start;
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 4px;
    }

    .gallery-filter-row button {
      flex: 0 0 auto;
    }
  }
</style>

