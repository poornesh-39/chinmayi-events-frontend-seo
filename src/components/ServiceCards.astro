---
import { services } from '../data/site.js';
import SmartImage from './SmartImage.astro';

const { limit } = Astro.props;
const visible = limit ? services.slice(0, limit) : services;
---

<div class="service-grid">
  {visible.map((service) => (
    <article class="service-card">
      <a href={`/services/${service.slug}/`} aria-label={`Learn more about ${service.title}`}>
        <SmartImage
          src={service.image}
          alt={`${service.shortTitle} by Chinmayi Events`}
          sizes="(max-width: 620px) 100vw, (max-width: 920px) 50vw, 33vw"
          widths={[400, 800, 1200]}
          width="720"
          height="520"
        />
        <div class="service-body">
          <h3>{service.shortTitle}</h3>
          <p>{service.description}</p>
          <span>Explore service</span>
        </div>
      </a>
    </article>
  ))}
</div>

<style>
  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .service-card {
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 16px 44px rgba(38, 23, 15, 0.07);
  }

  .service-card :global(img) {
    width: 100%;
    aspect-ratio: 1.28;
    object-fit: cover;
    transition: transform 260ms ease;
  }

  .service-card a {
    display: block;
    overflow: hidden;
  }

  .service-card:hover :global(img) {
    transform: scale(1.04);
  }

  .service-body {
    padding: 22px;
  }

  h3 {
    margin-bottom: 10px;
    font-size: 1.45rem;
  }

  p {
    min-height: 84px;
    color: var(--muted);
  }

  span {
    color: var(--maroon);
    font-weight: 850;
  }

  @media (max-width: 920px) {
    .service-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .service-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .service-card :global(img) {
      aspect-ratio: 1.6;
    }

    .service-body {
      padding: 18px;
    }

    h3 {
      font-size: 1.28rem;
    }

    p {
      min-height: 0;
      font-size: 0.94rem;
    }

    /* Give the whole card an obvious tap affordance on touch devices. */
    span {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      margin-top: 4px;
    }
  }
</style>
