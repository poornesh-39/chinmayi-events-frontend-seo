---
import { site, whatsappHref } from '../data/site.js';
---

<nav class="sticky-actions" id="sticky-actions" aria-label="Quick contact actions">
  <a class="sa-call" href={`tel:${site.phonePrimary}`} aria-label={`Call Chinmayi Events on ${site.phonePrimaryLabel}`}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 3.5h3l1.5 3.7-1.9 1.4a11 11 0 0 0 5.2 5.2l1.4-1.9 3.7 1.5v3a1.6 1.6 0 0 1-1.8 1.6C10.4 17.3 6.7 13.6 5 6.9A1.6 1.6 0 0 1 6.6 3.5Z"/></svg>
    <span>Call Us</span>
  </a>
  <a class="sa-wa" href={whatsappHref()} target="_blank" rel="noopener noreferrer" aria-label="Chat with Chinmayi Events on WhatsApp">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.2 19.2 6.4 15A7.2 7.2 0 1 1 9 17.6l-3.8 1.6Z"/></svg>
    <span>WhatsApp</span>
  </a>
</nav>

<script>
  const bar = document.getElementById('sticky-actions');

  if (bar) {
    // Stay out of the way until the visitor has scrolled past the hero, so the
    // first impression is the photography rather than a button bar.
    const threshold = () => Math.min(window.innerHeight * 0.72, 520);
    let ticking = false;

    const update = () => {
      bar.classList.toggle('is-visible', window.scrollY > threshold());
      ticking = false;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(update);
    };

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }
</script>

<style>
  .sticky-actions {
    display: none;
  }

  @media (max-width: 620px) {
    .sticky-actions {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 40;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1px;
      background: var(--line);
      border-top: 1px solid var(--line);
      box-shadow: 0 -8px 26px rgba(38, 23, 15, 0.12);
      transform: translateY(100%);
      transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .sticky-actions.is-visible {
      transform: translateY(0);
    }

    .sticky-actions a {
      min-height: 54px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 8px calc(10px + env(safe-area-inset-bottom) / 2);
      font-size: 0.78rem;
      font-weight: 900;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .sticky-actions svg {
      width: 17px;
      height: 17px;
      flex: 0 0 auto;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.9;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .sa-call {
      background: #fffdf8;
      color: var(--maroon-dark);
    }

    .sa-call:active {
      background: var(--soft);
    }

    .sa-wa {
      background: #128c4a;
      color: #fff;
    }

    .sa-wa:active {
      background: #0f7b41;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sticky-actions {
      transition: none;
    }
  }
</style>
